// Lists: `listOf`, the members of `List<T>` and the higher-order helpers written over them. The
// members belong to the list type: every file sees them without an import, and they always take
// precedence over extensions. `listOf` and the helpers are used after `import /prism/collections`.
package prism

// A list of the given elements, in order. It takes any number of elements, all of one type, and
// gives back the list its call built, or the list spread into it (`listOf(*xs)`).
public fun <T> listOf(vararg elements: T): List<T> = elements

// The number of elements.
public intrinsic val <T> List<T>.size: Int

// The valid indices, `0..<size`.
public intrinsic val <T> List<T>.indices: Range

// Whether the list has no element.
public intrinsic fun <T> List<T>.isEmpty(): Bool

// Whether the list has an element.
public intrinsic fun <T> List<T>.isNotEmpty(): Bool

// Whether an element equals `element`.
public intrinsic fun <T> List<T>.contains(element: &T): Bool

// The index of the first element equal to `element`, or `-1`.
public intrinsic fun <T> List<T>.indexOf(element: &T): Int

// Appends `element`.
public intrinsic mut fun <T> List<T>.add(element: T): Unit

// Places `element` at `index`, moving the later elements up by one.
public intrinsic mut fun <T> List<T>.insert(index: Int, element: T): Unit

// Removes the element at `index` and gives it by move, moving the later elements down by one.
public intrinsic mut fun <T> List<T>.removeAt(index: Int): T

// Removes the last element and gives it by move.
public intrinsic mut fun <T> List<T>.removeLast(): T

// Reverses the order of the elements in place.
public intrinsic mut fun <T> List<T>.reverse(): Unit

// Drops every element, keeping the list's buffer.
public intrinsic mut fun <T> List<T>.clear(): Unit

// Calls `action` on each element, in order.
public fun <T> List<T>.forEach(action: (&T) -> Unit): Unit {
    for (element in this) {
        action(element)
    }
}

// Calls `action` on each element, in order, with its index.
public fun <T> List<T>.forEachIndexed(action: (Int, &T) -> Unit): Unit {
    var index = 0
    for (element in this) {
        action(index, element)
        index += 1
    }
}

// A list of what `transform` gives for each element, in order.
public fun <T, R> List<T>.map(transform: (&T) -> R): List<R> {
    var result = listOf<R>()
    for (element in this) {
        result.add(transform(element))
    }
    return result
}

// The elements that satisfy `predicate`, in order, moved out of this list, which it consumes:
// the others are dropped, and no element is cloned.
public consuming fun <T> List<T>.filter(predicate: (&T) -> Bool): List<T> {
    var rest = this
    rest.reverse()
    var kept = listOf<T>()
    while (rest.isNotEmpty()) {
        val element = rest.removeLast()
        if (predicate(element)) {
            kept.add(element)
        }
    }
    return kept
}

// Whether some element satisfies `predicate`, calling it in order until one does.
public fun <T> List<T>.any(predicate: (&T) -> Bool): Bool {
    for (element in this) {
        if (predicate(element)) {
            return true
        }
    }
    return false
}

// Whether every element satisfies `predicate`, calling it in order until one does not.
public fun <T> List<T>.all(predicate: (&T) -> Bool): Bool {
    for (element in this) {
        if (!predicate(element)) {
            return false
        }
    }
    return true
}

// Whether no element satisfies `predicate`, calling it in order until one does.
public fun <T> List<T>.none(predicate: (&T) -> Bool): Bool {
    for (element in this) {
        if (predicate(element)) {
            return false
        }
    }
    return true
}

// The number of elements that satisfy `predicate`.
public fun <T> List<T>.count(predicate: (&T) -> Bool): Int {
    var count = 0
    for (element in this) {
        if (predicate(element)) {
            count += 1
        }
    }
    return count
}

// The index of the first element that satisfies `predicate`, or `-1`.
public fun <T> List<T>.indexOfFirst(predicate: (&T) -> Bool): Int {
    var index = 0
    for (element in this) {
        if (predicate(element)) {
            return index
        }
        index += 1
    }
    return -1
}

// `operation` applied to `initial` and the first element, then to its result and the next
// element, and so on: the last result, or `initial` for an empty list.
public fun <T, R> List<T>.fold(initial: R, operation: (R, &T) -> R): R {
    var accumulator = initial
    for (element in this) {
        accumulator = operation(accumulator, element)
    }
    return accumulator
}

// The sum of what `selector` gives for each element. An overflow is a runtime error, as for
// `+`.
public fun <T> List<T>.sumOf(selector: (&T) -> Int): Int {
    var total = 0
    for (element in this) {
        total = total + selector(element)
    }
    return total
}

// The texts `transform` gives for the elements, in order, with `separator` between them.
public fun <T> List<T>.joinToString(separator: &String = ", ", transform: (&T) -> String): String {
    var text = ""
    var first = true
    for (element in this) {
        if (!first) {
            text = text + separator
        }
        text = text + transform(element)
        first = false
    }
    return text
}
