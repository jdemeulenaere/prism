import /prism/core

// The closure borrows the paths `p.x` and `p.y`; the new body reads them in another order,
// so its contract is the same and the value made before the reload runs the new body.
struct P { val x: Int, val y: Int }
fun main() { val p = P(1, 2); val f: (Int) -> Int = { n -> n + p.x + p.y }; println(f(1)); println(f(1)) }
