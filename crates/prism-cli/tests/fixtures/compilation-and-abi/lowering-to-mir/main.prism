// expect: ok
enum Color { Red, Green }
struct User { val name: String, val age: Int? }
fun f(u: User?, c: Color, ok: Bool): Int {
    var total = u?.age ?: 0
    if (ok && total > 0) total = total + 1
    for (i in 0..<3) {
        total = total + when (c) { Red -> i; Green -> 0 }
    }
    return total
}
