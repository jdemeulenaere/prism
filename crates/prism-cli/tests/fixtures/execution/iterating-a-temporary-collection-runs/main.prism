// expect: ok
// run: 0
import /prism/collections
import /prism/core

struct Item { val name: String }
struct Bag { var items: List<Item> }

operator fun Bag.iterator(): Int = 0
operator fun Bag.hasNext(cursor: &Int): Bool = cursor < items.size
operator fun Bag.next(cursor: &mut Int): &Item {
    val i: Int = cursor
    *cursor = i + 1
    return &items[i]
}
fun make(): Bag = Bag(listOf(Item("x"), Item("y")))

fun main() {
    for (item in make()) println(item.name)
}
