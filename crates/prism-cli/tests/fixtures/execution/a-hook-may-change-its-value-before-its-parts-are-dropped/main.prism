import /prism/core
import /prism/collections

struct Noisy { val name: String }
operator mut fun Noisy.drop() { println("drop " + name) }
struct Guard { var inner: Noisy }
operator mut fun Guard.drop() { inner = Noisy("replaced") }
fun main() { val g = Guard(Noisy("first")) }
