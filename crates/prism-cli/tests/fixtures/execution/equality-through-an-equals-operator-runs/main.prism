import /prism/collections
import /prism/core

struct User { val id: Int, val name: String }
struct Team { val lead: User, val size: Int }

operator fun User.equals(other: &User): Bool = id == other.id

fun main() {
    println(User(1, "a") == User(1, "b"))
    println(User(1, "a") != User(2, "a"))
    println(Team(User(1, "a"), 3) == Team(User(1, "z"), 3))
    println(Heap(User(2, "a")) == Heap(User(2, "b")))
    val maybe: User? = User(1, "a")
    println(maybe == User(1, "c"))
    println(listOf(User(1, "a")) == listOf(User(1, "b")))
    println(User(3, "q") in listOf(User(3, "r")))
    println(listOf(User(1, "a"), User(2, "b")).indexOf(User(2, "x")))
}
