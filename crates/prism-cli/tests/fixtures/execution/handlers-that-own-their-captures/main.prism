// expect: ok
// run: 0
import /prism/collections
import /prism/core

fun makeHandler(label: String): () -> Unit = { println(label) }
fun main() {
    var handlers = listOf<() -> Unit>()
    for (i in 0..<3) handlers.add(makeHandler(i.toString()))
    val greeting = "hi".clone()
    handlers.add { println(greeting) }
    for (h in handlers) h()
    handlers.clear()
    println(handlers.size)
}
