import /prism/core
import /prism/collections

struct Noisy { val name: String }
operator mut fun Noisy.drop() { println("drop " + name) }
enum Slot { Full(Noisy), Empty }
operator mut fun Slot.drop() { println("drop slot") }
fun main() { val a = Slot.Full(Noisy("x")); val b = Slot.Empty }
