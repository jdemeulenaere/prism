package app

import /prism/compose/runtime
import /prism/core

// A borrow a weak reference lent, whose state was dropped, then freed by a pass.
fun consume(s: MutableState<Int>) {}

fun main() {
    val s = mutableStateOf(5)
    val ref = s.weak(); val c = composition { }; val kept = ref.get() ?: return; consume(s); c.setContent { }
    println(kept.value)
}
