import /prism/core
import /prism/collections

struct Noisy { val name: String }
operator mut fun Noisy.drop() { println("drop " + name) }
struct Pair { val first: Noisy, val second: Noisy }
operator mut fun Pair.drop() { println("drop pair of " + first.name) }
fun main() { val p = Pair(Noisy("1"), Noisy("2")) }
