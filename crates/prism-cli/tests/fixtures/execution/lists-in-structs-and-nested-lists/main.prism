// expect: ok
// run: 0
import /prism/collections
import /prism/core

struct Todo { val title: String, var done: Bool }
struct Model { var todos: List<Todo> }
fun main() {
    var m = Model(listOf())
    m.todos.add(Todo("write".clone(), false))
    m.todos.add(Todo("test".clone(), false))
    m.todos[1].done = true
    for (t in m.todos) if (t.done) println(t.title)
    var grid = listOf(listOf(1), listOf<Int>())
    grid[1].add(2)
    grid[0][0] = 3
    println(grid[0][0] + grid[1][0])
}
