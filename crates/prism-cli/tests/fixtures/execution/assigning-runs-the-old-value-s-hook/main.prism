// expect: ok
// run: 0
import /prism/core
import /prism/collections

struct Noisy { val name: String }
operator mut fun Noisy.drop() { println("drop " + name) }
fun consume(n: Noisy) { println("consume " + n.name) }
fun main() { var n = Noisy("a"); n = Noisy("b"); consume(n); n = Noisy("c"); println("end") }
