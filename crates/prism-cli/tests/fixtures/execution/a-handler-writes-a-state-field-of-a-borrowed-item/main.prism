// expect: ok
// run: 0
struct Todo { val id: Int, val done: MutableState<Bool> }
fun deliver(v: Bool, f: attached (Bool) -> Unit) { f(v) }
fun toggle(todo: &Todo) { deliver(true, { todo.done.value = it }) }
fun main() {
    val t = Todo(1, mutableStateOf(false))
    toggle(t)
    println(t.done.value)
}
