// expect: ok
// run: 0
import /prism/core

enum Chain<T> { Cons(T, Heap<Chain<T>>), Nil }
fun <T> Chain<T>.size(): Int = when (this) {
    Chain.Cons(_, val rest) -> 1 + rest.size()
    Chain.Nil -> 0
}
fun <T> push(list: Chain<T>, x: T): Chain<T> = Chain.Cons(x, Heap(list))
fun main() {
    val empty: Chain<String> = Chain.Nil
    val names = push(push(empty, "a"), "b")
    val none: Chain<Int> = Chain.Nil
    val numbers = push(none, 1)
    println(names.size())
    println(numbers.size())
}
