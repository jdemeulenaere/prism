import /prism/core
import /prism/collections

struct Noisy { val name: String }
operator mut fun Noisy.drop() { println("drop " + name) }
struct Holder { val n: Noisy, val tag: Int }
fun main() { val h = Heap(Noisy("boxed")); val o: Noisy? = Noisy("maybe"); val none: Noisy? = null; val held = Holder(Noisy("held"), 1); val out = Heap(Noisy("out")).unbox(); println("end") }
