// expect: ok
// run: 0
import /prism/collections
import /prism/core

struct Team { val members: List<String> }

val Team.label: String get() {
    if (members.isEmpty()) return "empty"
    return members[0].clone()
}

fun main() {
    println(Team(listOf("ann", "bo")).label)
    println(Team(listOf()).label)
}
