// expect: E4034
struct Modifier : Copy { val fraction: Double }
struct RowScope : Copy {}
struct BoxScope : Copy {}
fun box(f: BoxScope.() -> Unit) { f(BoxScope()) }
context(scope: RowScope)
fun Modifier.weight(w: Double): Modifier = Modifier(w)
fun use(m: Modifier) {}
context(scope: RowScope)
fun g() { box { use(Modifier(0.0).weight(1.0)) } }
