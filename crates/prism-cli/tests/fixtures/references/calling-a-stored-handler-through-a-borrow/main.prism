// expect: ok
// run: 0
import /prism/core

struct Button { val onClick: () -> Int }
fun fire(b: &Button): Int = b.onClick() + b.onClick()
fun twice(h: escaping () -> Int): Int {
    val a = h()
    return a + h()
}
fun main() {
    val n = 4
    println(fire(Button({ n })))
    println(twice { n + 1 })
}
