// expect: ok
struct User {
    val name: String
}
fun User.greet(): String = "Hi"
fun String.shout(): String = "!"
fun make(): User = User("a")
fun f(u: User, r: &User, rr: &&User, m: &mut User, h: Heap<User>) {
    u.greet()
    u.name.shout()
    r.greet()
    rr.greet()
    m.greet()
    h.greet()
    make().greet()
    "a".shout()
    val keep: User = u
}
