// expect: E5007
// run: 1
// The returned closure owns 'h', which holds the reference 'r' or the unmarked parameter 'p':
// the diagnostic names 'h' where it is captured and the parameter where it is declared.
fun f(r: &Int): () -> Int {
    val h = { r + 1 }
    return { h() }
}
fun g(p: () -> Int): () -> Int {
    val h = { p() + 1 }
    return { h() }
}
fun main() {}
