package app
import /prism/compose/ui
import /prism/compose/layout
import /prism/compose/material3
import /lib/inner
import /prism/compose/runtime

compose fun Outer(a: Int, b: Int) {
    Inner(a, b)
}
compose fun Screen() {
    val c = remember { mutableStateOf(1) }
    Column {
        Outer(c.value, 2)
        Button(onClick = { c.value += 10 }) { Text("+") }
    }
}
fun main() { runApp(width = 400, height = 300) { Screen() } }
