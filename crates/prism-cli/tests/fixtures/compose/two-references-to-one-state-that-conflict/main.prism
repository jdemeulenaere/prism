// expect: ok
// run: 101
import /prism/collections
import /prism/compose/runtime
import /prism/core

fun f(a: &MutableState<List<Int>>, b: &MutableState<List<Int>>) {
    val items = &a.value
    b.value.add(3)
    println(items.size)
}
fun main() {
    val s = mutableStateOf(listOf(1))
    f(s, s)
}
