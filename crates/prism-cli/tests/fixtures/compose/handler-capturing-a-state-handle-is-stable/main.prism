// expect: ok
// run: 0
compose fun Plus(onClick: escaping () -> Unit) {
    println("plus")
}

compose fun Screen(count: MutableState<Int>, tick: State<Int>) {
    println("screen ${tick.value}")
    Plus(onClick = { count.value += 1 })
}

fun main() {
    val count = mutableStateOf(0)
    val tick = mutableStateOf(0)
    val c = composition { Screen(count, tick) }
    tick.value = 1
    println(c.recompose())
}
