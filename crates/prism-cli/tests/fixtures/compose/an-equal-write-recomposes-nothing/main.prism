// expect: ok
// run: 0
compose fun Show(n: State<Int>, s: State<String>) {
    println("show ${n.value} ${s.value}")
}

fun main() {
    val n = mutableStateOf(1)
    val s = mutableStateOf("a" + "b")
    val c = composition { Show(n, s) }
    n.value = 1
    s.value = "a" + "b"
    n.value += 0
    println(c.recompose())
}
