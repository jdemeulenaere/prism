// expect: ok
// run: 0
compose fun Counter(tick: &State<Int>) {
    val clicks = remember {
        println("created")
        mutableStateOf(7)
    }
    println("tick ${tick.value} clicks ${clicks.value}")
}

fun main() {
    val tick = mutableStateOf(0)
    val c = composition { Counter(tick) }
    tick.value += 1
    println(c.recompose())
}
