import /prism/compose/ui
import /prism/compose/foundation
import /prism/compose/layout
import /prism/compose/material3
import /prism/compose/runtime

struct Item { val title: String }
compose fun Label(item: &Item, count: &State<Int>) { Text("${item.title} ${count.value}") }
compose fun Counter() {
    val c = remember { mutableStateOf(0) }
    val item = remember { Item("a" + "b") }
    Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
        Label(item, c)
        Button(onClick = { c.value += 1 }) { Text("+") }
    }
}
fun main() { runApp(width = 400, height = 300) { Counter() } }
