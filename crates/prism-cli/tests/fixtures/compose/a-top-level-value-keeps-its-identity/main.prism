// expect: ok
// run: 0
val Greeting: String = "hello"
compose fun Show(s: &String) { println("show $s") }
compose fun Screen(tick: &State<Int>) {
    println("screen ${tick.value}")
    Show(Greeting)
}
fun main() {
    val tick = mutableStateOf(0)
    val c = composition { Screen(tick) }
    tick.value = 1
    println(c.recompose())
}
