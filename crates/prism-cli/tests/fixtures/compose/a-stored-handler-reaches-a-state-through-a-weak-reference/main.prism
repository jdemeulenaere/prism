// expect: ok
// run: 0
import /prism/compose/runtime
import /prism/core

struct Clicker { val onClick: () -> Unit }
fun clicker(count: &MutableState<Int>): Clicker {
    val ref = count.weak()
    return Clicker({ ref.get()?.update { it + 1 } })
}
fun main() {
    val count = mutableStateOf(0)
    val c = clicker(count)
    c.onClick()
    c.onClick()
    println(count.value)
}
