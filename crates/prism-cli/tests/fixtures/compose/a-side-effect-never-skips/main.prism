// expect: ok
// run: 0
import /prism/compose/runtime
import /prism/core

compose fun Log(n: Int, tick: Int) {
    println("log $tick")
    SideEffect { println("effect $n") }
}

fun screen(t: Int): compose () -> Unit = { Log(1, t) }

fun main() {
    val c = composition(screen(1))
    c.setContent(screen(2))
}
