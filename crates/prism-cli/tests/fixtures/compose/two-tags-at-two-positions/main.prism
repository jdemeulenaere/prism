// expect: ok
// run: 0
import /prism/composer
import /prism/core

fun main() {
    val c = startComposition { k ->
        startGroup(k, 1)
        val a = rememberInt(k, 1) {
            println("calc 10")
            10
        }
        val b = rememberInt(k, 2) {
            println("calc 20")
            20
        }
        println(a + b)
        endGroup(k)
    }
    invalidate(rootScope(c))
    recomposeComposition(c)
    print(dumpComposition(c))
    disposeComposition(c)
}
