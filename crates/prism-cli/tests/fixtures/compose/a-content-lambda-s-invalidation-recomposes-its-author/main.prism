import /prism/compose/runtime
import /prism/core

compose fun Column(content: compose () -> Unit) { content() }
compose fun Screen() { println("screen"); Column { val s = currentRecomposeScope(); val first = remember { s.invalidate(); 0 }; println("content") } }
fun main() { val c = composition { Screen() }; println(c.recompose()) }
