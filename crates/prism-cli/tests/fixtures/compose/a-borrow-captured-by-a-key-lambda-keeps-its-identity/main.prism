// expect: ok
// run: 0
import /prism/collections
import /prism/compose/runtime
import /prism/core

compose fun Show(s: &String) { println("show $s") }
compose fun Screen(items: &State<List<String>>, tick: &State<Int>) {
    println("screen ${tick.value}")
    for (s in items.value) {
        key(s.length) { Show(s) }
    }
}
fun main() {
    val items = mutableStateOf(listOf("a", "bb"))
    val tick = mutableStateOf(0)
    val c = composition { Screen(items, tick) }
    tick.value = 1
    println(c.recompose())
}
