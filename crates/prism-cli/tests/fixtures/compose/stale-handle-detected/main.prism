// expect: ok
// run: 101
compose fun Child(holder: MutableState<MutableState<Int>>) {
    val s = remember { mutableStateOf(5) }
    SideEffect { holder.value = s }
}

compose fun Parent(show: State<Bool>, holder: MutableState<MutableState<Int>>) {
    if (show.value) {
        Child(holder)
    }
}

fun main() {
    val show = mutableStateOf(true)
    val holder = mutableStateOf(mutableStateOf(0))
    val c = composition { Parent(show, holder) }
    val kept = holder.value
    println(kept.value)
    show.value = false
    println(c.recompose())
    println(kept.value)
}
