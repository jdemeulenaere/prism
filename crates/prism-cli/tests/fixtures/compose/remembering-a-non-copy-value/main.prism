import /prism/compose/runtime
import /prism/core

compose fun Leaf() { }
compose fun C(label: String) {
    val s = remember { println("computed"); "a" + "b" }
    Leaf()
    println(s.length)
}
fun screen(): compose () -> Unit = { C("x") }
fun main() {
    val c = composition(screen())
    c.setContent(screen())
}
