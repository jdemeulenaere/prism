// expect: ok
// run: 0
compose fun Row(id: Int) { val v = remember { println("computed $id"); id * 10 }; println("row $id $v") }
compose fun Rows(order: Int) { for (i in 1..3) { val id = if (order == 0) i else (i + 1) % 3 + 1; key(id) { Row(id) } } }
fun screen(order: Int): compose () -> Unit = { Rows(order) }
fun main() { val c = composition(screen(0)); c.setContent(screen(1)); print(c.dump()) }
