// expect: ok
// run: 0
import /prism/collections
import /prism/compose/runtime
import /prism/core

compose fun Show(s: &String, n: &State<Int>) { println("show $s ${n.value}") }
compose fun Screen(items: &State<List<String>>, n: &State<Int>) {
    println("screen")
    Show(items.value[0], n)
}
fun main() {
    val items = mutableStateOf(listOf("a" + "b"))
    val n = mutableStateOf(0)
    val c = composition { Screen(items, n) }
    n.value = 1
    println(c.recompose())
}
