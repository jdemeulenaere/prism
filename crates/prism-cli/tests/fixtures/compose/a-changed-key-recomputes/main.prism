// expect: ok
// run: 0
import /prism/compose/runtime
import /prism/core

compose fun K(n: Int, label: String) { val v = remember(n) { println("calc $n"); n * 10 }; println(v) }
fun screen(n: Int): compose () -> Unit = { K(n, "x") }
fun main() { val c = composition(screen(1)); c.setContent(screen(1)); c.setContent(screen(2)); print(c.dump()) }
