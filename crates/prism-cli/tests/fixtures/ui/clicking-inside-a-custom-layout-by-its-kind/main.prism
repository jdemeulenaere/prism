// expect: ok
// run: 0
// headless: 400x300
// events: events.txt
import /prism/compose/ui
import /prism/compose/foundation
import /prism/compose/layout
import /prism/compose/material3
import /prism/compose/runtime
import /prism/collections
import /prism/core

compose fun Diagonal(content: compose () -> Unit) {
    Layout(content = content) { measurables, constraints ->
        val placeables = measurables.map { it.measure(constraints) }
        var width = 0
        var height = 0
        for (p in placeables) {
            width += p.width
            height += p.height
        }
        layout(width, height) {
            var x = 0
            var y = 0
            for (p in placeables) {
                p.place(x, y)
                x += p.width
                y += p.height
            }
        }
    }
}

fun main() {
    runApp(width = 400, height = 300) {
        Diagonal {
            Button(onClick = { println("hit") }) { Text("go") }
        }
    }
}
