import /prism/compose/ui
import /prism/compose/foundation
import /prism/compose/layout
import /prism/compose/material3
compose fun Two() {
    val c = remember { mutableStateOf(0) }
    val m = Modifier.size(10.dp).clickable { c.value += 1 }
    Column {
        Box(modifier = m) { }
        Box(modifier = m) { }
        Text("${c.value}")
    }
}
fun main() { runApp(width = 400, height = 300) { Two() } }
