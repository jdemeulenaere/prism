// expect: ok
// run: 101
// headless: 400x300
// events: events.txt
import /prism/compose/ui
import /prism/compose/foundation
import /prism/compose/layout
import /prism/compose/material3
import /prism/compose/runtime
import /prism/collections
import /prism/core

fun main() {
    runApp(width = 400, height = 300) {
        Layout(content = {
            Text("shown")
            Text("hidden")
        }) { measurables, constraints ->
            val first = measurables[0].measure(constraints)
            layout(first.width, first.height) { first.place(0, 0) }
        }
    }
}
