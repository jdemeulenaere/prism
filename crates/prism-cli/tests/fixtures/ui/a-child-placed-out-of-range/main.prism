// expect: ok
// run: 0
// headless: 400x300
// events: events.txt
import /prism/compose/ui
import /prism/compose/foundation
import /prism/compose/layout
import /prism/compose/material3
import /prism/compose/runtime
import /prism/collections
import /prism/core

fun main() {
    runApp(width = 400, height = 300) {
        Column(modifier = Modifier.padding(10.dp)) {
            Layout(content = { Text("far"); Text("near") }) { measurables, constraints ->
                val far = measurables[0].measure(constraints)
                val near = measurables[1].measure(constraints)
                layout(near.width, near.height) {
                    far.place(Constraints.Infinity, -9223372036854775807 - 1)
                    near.place(0, 0)
                }
            }
        }
    }
}
