import /prism/compose/ui
import /prism/compose/foundation
import /prism/compose/layout
import /prism/compose/material3
import /prism/compose/runtime
import /prism/core

compose fun Card(modifier: Modifier) {
    println("card")
    Box(modifier = modifier) { }
}
compose fun Screen() {
    val c = remember { mutableStateOf(0) }
    Column {
        Text("${c.value}")
        Card(modifier = Modifier.size(40.dp).clickable { c.value += 1 })
    }
}
fun main() { runApp(width = 400, height = 300) { Screen() } }
