window 300x300
  column #1 0,0 80x80
    text #2 0,0 0x20
      text #3 0,0 0x0 "child" unplaced
      text #4 0,0 0x0 "second" unplaced
    textfield #5 0,20 0x20
    box #6 0,40 80x40 contentColor #FFFFFFFF background(#FF6750A4 RoundedCorner(50%)) clickable(Button)
      row #7 0,40 80x40 arrangement Center alignment CenterVertically defaultMinSize(58x40) padding(24,8,24,8)
        text #8 24,50 32x20 "flip"
