// expect: ok
// run: 0
// headless: 400x300
// events: events.txt
import /prism/compose/ui
import /prism/compose/layout
import /prism/compose/material3
struct Item { val id: Int, val title: String, val done: MutableState<Bool> }
compose fun ItemRow(item: &Item) {
    Row {
        Checkbox(checked = item.done.value, onCheckedChange = { item.done.value = it })
        Text(item.title)
    }
}
compose fun Screen() {
    val items = remember { mutableStateOf(listOf(Item(1, "a", mutableStateOf(false)), Item(2, "b", mutableStateOf(false)))) }
    Column {
        for (item in items.value) {
            key(item.id) { ItemRow(item) }
        }
        Button(onClick = { items.value.removeAt(0) }) { Text("remove first") }
    }
}
fun main() { runApp(width = 400, height = 300) { Screen() } }
