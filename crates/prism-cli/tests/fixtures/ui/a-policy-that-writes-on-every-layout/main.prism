// expect: ok
// run: 0
// headless: 400x300
// events: events.txt
import /prism/compose/ui
import /prism/compose/foundation
import /prism/compose/layout
import /prism/compose/material3
import /prism/compose/runtime
import /prism/collections
import /prism/core

fun main() {
    runApp(width = 400, height = 300) {
        val count = remember { mutableStateOf(1) }
        Column {
            Layout(content = { Spacer(modifier = Modifier.width(count.value.dp)) }) { measurables, constraints ->
                count.value = count.value + 1
                val a = measurables[0].measure(constraints)
                layout(a.width, a.height) { a.place(0, 0) }
            }
            Text("count ${count.value}")
        }
    }
}
