// expect: ok
// run: 0
// headless: 400x300
// events: events.txt
import /prism/compose/ui
import /prism/compose/foundation
import /prism/compose/layout
import /prism/compose/material3
import /prism/compose/runtime
import /prism/collections
import /prism/core

// Measures its child with no bound on either axis, and is 10 × 10 itself.
compose fun Unbounded(content: compose () -> Unit) {
    Layout(content = content) { measurables, constraints ->
        val child = measurables[0].measure(
            Constraints(0, Constraints.Infinity, 0, Constraints.Infinity),
        )
        layout(10, 10) { child.place(0, 0) }
    }
}

fun main() {
    runApp(width = 400, height = 300) {
        Unbounded {
            Box(modifier = Modifier.padding(5.dp).background(Color.Red)) {
                Layout(content = { }) { measurables, constraints ->
                    layout(constraints.maxWidth, constraints.maxHeight) { }
                }
            }
        }
    }
}
