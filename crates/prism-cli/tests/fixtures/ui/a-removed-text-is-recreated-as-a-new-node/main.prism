// events: events.txt
import /prism/compose/ui
import /prism/compose/foundation
import /prism/compose/layout
import /prism/compose/material3
import /prism/compose/runtime

compose fun Toggle() {
    val on = remember { mutableStateOf(true) }
    Column {
        if (on.value) {
            Text("shown")
        }
        Button(onClick = { on.value = !on.value }) { Text("toggle") }
    }
}
fun main() { runApp(width = 400, height = 300) { Toggle() } }
