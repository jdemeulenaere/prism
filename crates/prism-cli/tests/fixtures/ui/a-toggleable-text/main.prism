import /prism/compose/ui
import /prism/compose/foundation
import /prism/compose/layout
import /prism/compose/material3
compose fun Switcher() {
    val on = remember { mutableStateOf(false) }
    Text(if (on.value) "on" else "off", modifier = Modifier.toggleable(value = on.value) { on.value = it })
}
fun main() { runApp(width = 400, height = 300) { Switcher() } }
