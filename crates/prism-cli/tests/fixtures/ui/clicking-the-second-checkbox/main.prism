// expect: ok
// run: 0
// headless: 400x300
// events: events.txt
import /prism/compose/ui
import /prism/compose/layout
import /prism/compose/material3
import /prism/compose/runtime

compose fun Two() {
    val a = remember { mutableStateOf(false) }
    val b = remember { mutableStateOf(false) }
    Column {
        Checkbox(checked = a.value, onCheckedChange = { a.value = it })
        Checkbox(checked = b.value, onCheckedChange = { b.value = it })
    }
}
fun main() { runApp(width = 400, height = 300) { Two() } }
