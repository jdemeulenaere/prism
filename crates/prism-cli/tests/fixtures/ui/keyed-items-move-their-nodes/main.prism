// expect: ok
// run: 0
// events: events.txt
import /prism/compose/ui
import /prism/compose/foundation
import /prism/compose/layout
import /prism/compose/material3
compose fun Items() {
    val reversed = remember { mutableStateOf(false) }
    Column {
        val ids = if (reversed.value) listOf(3, 2, 1) else listOf(1, 2, 3)
        for (id in ids) {
            key(id) { Text("item $id") }
        }
        Button(onClick = { reversed.value = true }) { Text("reverse") }
    }
}
fun main() { runApp(width = 400, height = 300) { Items() } }
