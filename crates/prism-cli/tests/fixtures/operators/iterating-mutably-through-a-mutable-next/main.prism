// expect: E4003
import /prism/collections

struct Item { var name: String }
struct Bag { var items: List<Item> }

operator fun Bag.iterator(): Int = 0
operator fun Bag.hasNext(cursor: &Int): Bool = cursor < items.size
operator fun Bag.next(cursor: &mut Int): &Item {
    val i: Int = cursor
    *cursor = i + 1
    return &items[i]
}
operator mut fun Bag.next(cursor: &mut Int): &mut Item {
    val i: Int = cursor
    *cursor = i + 1
    return &mut items[i]
}

fun f(b: &mut Bag) {
    for (item in b) {
        item.name = "x"
    }
}
fun g() {
    var b = Bag(listOf())
    for (item in b) {
        item.name = "x"
    }
}
fun h() {
    var b = Bag(listOf())
    for (item in &mut b) {
        item.name = "x"
    }
}
