// expect: ok
// run: 0
import /prism/core

struct User { val id: Int, val name: String }

operator fun User.equals(other: &User): Bool = id == other.id

fun f(a: &User, b: &User): Bool = a == b

fun main() {
    println(f(&User(1, "a"), &User(1, "b")))
    println(f(&User(1, "a"), &User(2, "a")))
}
