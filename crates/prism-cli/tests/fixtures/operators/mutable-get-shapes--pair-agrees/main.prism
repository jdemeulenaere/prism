// expect: ok
struct Item { var count: Int }
struct Bag { var items: List<Item> }

operator fun Bag.get(index: Int): &Item = &items[index]
operator mut fun Bag.get(index: Int): &mut Item = &mut items[index]
operator fun Bag.iterator(): Int = 0
operator fun Bag.hasNext(cursor: &Int): Bool = cursor < items.size
operator fun Bag.next(cursor: &mut Int): &Item {
    val i: Int = cursor
    *cursor = i + 1
    return &items[i]
}
operator mut fun Bag.next(cursor: &mut Int): &mut Item {
    val i: Int = cursor
    *cursor = i + 1
    return &mut items[i]
}

fun f(b: &Bag): Int = b.get(0).count
