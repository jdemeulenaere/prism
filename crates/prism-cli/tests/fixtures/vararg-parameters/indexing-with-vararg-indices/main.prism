// expect: ok
// run: 0
import /prism/collections
import /prism/core

struct Grid { var cells: List<Int> }

operator fun Grid.get(vararg at: Int): Int = cells[at.size]

operator mut fun Grid.set(vararg at: Int, value: Int) {
    cells[at.size] = value
}

fun main() {
    var g = Grid(listOf(0, 0, 0))
    g[1, 1] = 5
    g[1, 1] += 2
    g[9] = 3
    println(g[1, 1])
    println(g[4])
}
