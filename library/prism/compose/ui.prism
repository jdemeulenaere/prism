// The UI toolkit's base, after Jetpack Compose's `compose-ui` artifact with `ui-graphics`,
// `ui-unit` and `ui-text` (`androidx.compose.ui` and its `graphics`, `unit`, `text`,
// `semantics` and `window` packages): modifiers, alignments, colours, shapes, units, text
// styles, roles, `runApp`, and the layout primitive (`androidx.compose.ui.layout`): `Layout`,
// `Constraints`, `Measurable`, `Placeable` and `MeasureScope`. With `package` visibility, it
// also holds the node layer that the other toolkit modules of `prism.compose` are written over:
// `Node`, `LeafNode`, `LayoutNode`, the node kinds and the UI runtime's setters, whose nodes,
// handlers and measure policies live in `prism-ui`. A modifier is plain data, an ordered chain
// of elements that its node applies; no modifier composes.
package prism.compose

import /prism/core
import runtime

// A node of the UI tree: one word naming a node of the UI runtime, `Copy`.
package struct NodeId : Copy { package val word: Int }

// A handler of the UI runtime's handler table, named by a modifier element: one word, `Copy`,
// that no program constructs.
public struct HandlerId : Copy { package val word: Int }

// Whether two ids name handlers with the same code and equal captures.
public operator fun HandlerId.equals(other: &HandlerId): Bool = prism_ui_handlers_equal(
    word,
    other.word,
)

// A node group of `kind`: `update` receives its node on every pass, then `content` composes
// its children. It starts no group but its node group, whose key is Compose's node key, 125:
// node groups match their old siblings in order, and a node of another kind is a new node.
// Compose's `ComposeNode`.
@ExplicitGroupsComposable
package compose fun Node(kind: Int, update: (NodeId) -> Unit, content: compose () -> Unit): Unit {
    val composer = currentComposer()
    update(NodeId(prism_compose_start_node_group(composer, 125, kind)))
    content()
    prism_compose_end_group(composer)
}

// A node group of `kind` without children: `update` receives its node on every pass.
@ExplicitGroupsComposable
package compose fun LeafNode(kind: Int, update: (NodeId) -> Unit): Unit {
    val composer = currentComposer()
    update(NodeId(prism_compose_start_node_group(composer, 125, kind)))
    prism_compose_end_group(composer)
}

// The node kind of a column.
package val columnKind: Int = 1

// The node kind of a row.
package val rowKind: Int = 2

// The node kind of a box.
package val boxKind: Int = 3

// The node kind of a text.
package val textKind: Int = 4

// The node kind of a spacer.
package val spacerKind: Int = 5

// The node kind of a text field.
package val textFieldKind: Int = 6

// The node kind of a user layout.
package val layoutKind: Int = 7

// Sets the text of a text node, or the value of a text field.
package external fun prism_ui_set_text(node: Int, text: &String): Unit

// Sets a node's text colour (an `argb` word) and font size, either unspecified.
package external fun prism_ui_set_text_style(node: Int, color: Int, fontSize: Int): Unit

// Sets a node's modifier chain.
package external fun prism_ui_set_modifier(node: Int, modifier: &Modifier): Unit

// Sets a row's or column's arrangement: its code and spacing.
package external fun prism_ui_set_arrangement(node: Int, code: Int, space: Int): Unit

// Sets a box's content alignment, or the cross-axis alignment of a row or column.
package external fun prism_ui_set_alignment(node: Int, code: Int): Unit

// Sets the colour a node's texts take when their own is unspecified.
package external fun prism_ui_set_content_color(node: Int, color: Int): Unit

// Sets whether a text field takes input.
package external fun prism_ui_set_enabled(node: Int, enabled: Bool): Unit

// Gives a text field the handler its edits call.
package external fun prism_ui_set_on_value_change(node: Int, handler: Int): Unit

// Moves a click handler into the handler table, until a node claims it.
package external fun prism_ui_register_click(handler: attached () -> Unit): Int

// Moves a toggle handler into the handler table, until a node claims it.
package external fun prism_ui_register_toggle(handler: attached (Bool) -> Unit): Int

// Moves a text field's edit handler into the handler table, until a node claims it.
package external fun prism_ui_register_text(handler: attached (String) -> Unit): Int

// Ends the program: a chain cannot hold a seventeenth element.
package external fun prism_ui_modifier_overflow(): Nothing

// Moves a layout's measure policy into the handler table, until a node claims it.
package external fun prism_ui_register_measure_policy(
    policy: attached MeasureScope.(&List<Measurable>, Constraints) -> MeasureResult,
): Int

// Moves a `Modifier.layout`'s step into the handler table, until a node claims it.
package external fun prism_ui_register_layout_modifier(
    measure: attached MeasureScope.(Measurable, Constraints) -> MeasureResult,
): Int

// Gives a layout node its measure policy.
package external fun prism_ui_set_measure_policy(node: Int, policy: Int): Unit

// A colour: an ARGB value in the low 32 bits, or unspecified outside them.
public struct Color : Copy { val argb: Int }

// Jetpack Compose's named colours.
public struct Colors : Copy {
    val Black: Color
    val DarkGray: Color
    val Gray: Color
    val LightGray: Color
    val White: Color
    val Red: Color
    val Green: Color
    val Blue: Color
    val Yellow: Color
    val Cyan: Color
    val Magenta: Color
    val Transparent: Color
    val Unspecified: Color
}

// The named colours, as `Color.Red`; `Color(0xFF336699)` builds any other.
public val Color: Colors = Colors(
    Black = Color(0xFF000000),
    DarkGray = Color(0xFF444444),
    Gray = Color(0xFF888888),
    LightGray = Color(0xFFCCCCCC),
    White = Color(0xFFFFFFFF),
    Red = Color(0xFFFF0000),
    Green = Color(0xFF00FF00),
    Blue = Color(0xFF0000FF),
    Yellow = Color(0xFFFFFF00),
    Cyan = Color(0xFF00FFFF),
    Magenta = Color(0xFFFF00FF),
    Transparent = Color(0x00000000),
    Unspecified = Color(0x1_0000_0000),
)

// A shape: a corner radius in logical pixels and a percentage of the smaller side; the larger
// of the two is drawn.
public struct Shape : Copy { val cornerRadius: Int, val cornerPercent: Int }

// The shape without rounded corners.
public val RectangleShape: Shape = Shape(0, 0)

// An alignment of a child in the space left to it, by its code: the nine two-axis values, then
// the horizontal and vertical ones.
public struct Alignment : Copy { val code: Int }

// Jetpack Compose's alignments.
public struct Alignments : Copy {
    val TopStart: Alignment
    val TopCenter: Alignment
    val TopEnd: Alignment
    val CenterStart: Alignment
    val Center: Alignment
    val CenterEnd: Alignment
    val BottomStart: Alignment
    val BottomCenter: Alignment
    val BottomEnd: Alignment
    val Start: Alignment
    val CenterHorizontally: Alignment
    val End: Alignment
    val Top: Alignment
    val CenterVertically: Alignment
    val Bottom: Alignment
}

// The alignments, as `Alignment.Center`.
public val Alignment: Alignments = Alignments(
    TopStart = Alignment(0),
    TopCenter = Alignment(1),
    TopEnd = Alignment(2),
    CenterStart = Alignment(3),
    Center = Alignment(4),
    CenterEnd = Alignment(5),
    BottomStart = Alignment(6),
    BottomCenter = Alignment(7),
    BottomEnd = Alignment(8),
    Start = Alignment(9),
    CenterHorizontally = Alignment(10),
    End = Alignment(11),
    Top = Alignment(12),
    CenterVertically = Alignment(13),
    Bottom = Alignment(14),
)

// The semantics role of a clickable or toggleable element, by its code.
public struct Role : Copy { val code: Int }

// Jetpack Compose's semantics roles.
public struct Roles : Copy {
    val Button: Role
    val Checkbox: Role
    val Switch: Role
    val RadioButton: Role
    val Tab: Role
    val Image: Role
    val DropdownList: Role
}

// The roles, as `Role.Button`.
public val Role: Roles = Roles(
    Button = Role(1),
    Checkbox = Role(2),
    Switch = Role(3),
    RadioButton = Role(4),
    Tab = Role(5),
    Image = Role(6),
    DropdownList = Role(7),
)

// A size in whole logical pixels; negative values are unspecified where a size may be.
public struct Dp : Copy { val value: Int }

// The size that is not given.
public struct Dps : Copy { val Unspecified: Dp }

// `Dp.Unspecified`.
public val Dp: Dps = Dps(Unspecified = Dp(-1))

// `n` logical pixels, as `16.dp`.
public val Int.dp: Dp get() = Dp(this)

// A font size in whole logical pixels; negative values are unspecified.
public struct TextUnit : Copy { val value: Int }

// The font size that is not given.
public struct TextUnits : Copy { val Unspecified: TextUnit }

// `TextUnit.Unspecified`.
public val TextUnit: TextUnits = TextUnits(Unspecified = TextUnit(-1))

// A font size of `n` logical pixels, as `14.sp`.
public val Int.sp: TextUnit get() = TextUnit(this)

// How a text is drawn: its colour and font size, either unspecified.
public struct TextStyle : Copy { val color: Color, val fontSize: TextUnit }

// The style that specifies nothing.
public struct TextStyles : Copy { val Default: TextStyle }

// `TextStyle.Default`.
public val TextStyle: TextStyles = TextStyles(
    Default = TextStyle(Color.Unspecified, TextUnit.Unspecified),
)

// One element of a modifier chain, with whole-pixel payloads and codes.
public enum ModifierElement : Copy {
    None
    Padding(Int, Int, Int, Int)
    Size(Int, Int)
    DefaultMinSize(Int, Int)
    FillMax(Bool, Bool, Double)
    Weight(Double, Bool)
    Align(Alignment)
    Background(Color, Shape)
    Border(Int, Color, Shape)
    Clickable(HandlerId, Bool, Int)
    Toggleable(HandlerId, Bool, Bool, Int)
    TextFieldFrame(Color, Color)
    Offset(Int, Int)
    LayoutModifier(HandlerId)
}

// Eight elements of a chain.
public struct ModifierElements : Copy {
    private val e0: ModifierElement
    private val e1: ModifierElement
    private val e2: ModifierElement
    private val e3: ModifierElement
    private val e4: ModifierElement
    private val e5: ModifierElement
    private val e6: ModifierElement
    private val e7: ModifierElement
}

// An ordered chain of at most 16 elements: each one applies to the layout of the elements after
// it. Two chains are equal when they hold equal elements in the same order.
public struct Modifier : Copy {
    private val count: Int
    private val first: ModifierElements
    private val second: ModifierElements
}

// Eight empty elements.
private val emptyElements: ModifierElements = ModifierElements(
    ModifierElement.None,
    ModifierElement.None,
    ModifierElement.None,
    ModifierElement.None,
    ModifierElement.None,
    ModifierElement.None,
    ModifierElement.None,
    ModifierElement.None,
)

// The empty chain, which every chain starts from: `Modifier.padding(16.dp)`.
public val Modifier: Modifier = Modifier(0, emptyElements, emptyElements)

// The elements with `element` at `index`.
private fun ModifierElements.with(
    index: Int,
    element: ModifierElement,
): ModifierElements = when (index) {
    0 -> ModifierElements(element, e1, e2, e3, e4, e5, e6, e7)
    1 -> ModifierElements(e0, element, e2, e3, e4, e5, e6, e7)
    2 -> ModifierElements(e0, e1, element, e3, e4, e5, e6, e7)
    3 -> ModifierElements(e0, e1, e2, element, e4, e5, e6, e7)
    4 -> ModifierElements(e0, e1, e2, e3, element, e5, e6, e7)
    5 -> ModifierElements(e0, e1, e2, e3, e4, element, e6, e7)
    6 -> ModifierElements(e0, e1, e2, e3, e4, e5, element, e7)
    else -> ModifierElements(e0, e1, e2, e3, e4, e5, e6, element)
}

// The element at `index`.
private fun ModifierElements.at(index: Int): ModifierElement = when (index) {
    0 -> e0
    1 -> e1
    2 -> e2
    3 -> e3
    4 -> e4
    5 -> e5
    6 -> e6
    else -> e7
}

// This chain followed by `element`; a seventeenth element ends the program.
package fun Modifier.append(element: ModifierElement): Modifier {
    if (count >= 16) {
        prism_ui_modifier_overflow()
    }
    if (count < 8) {
        return Modifier(count + 1, first.with(count, element), second)
    }
    return Modifier(count + 1, first, second.with(count - 8, element))
}

// The element at `index` of this chain.
package fun Modifier.element(index: Int): ModifierElement =
    if (index < 8) first.at(index) else second.at(index - 8)

// This chain followed by the elements of `other`, in order.
public fun Modifier.then(other: Modifier): Modifier {
    var chain: Modifier = this
    for (index in 0..<other.count) {
        chain = chain.append(other.element(index))
    }
    return chain
}

// This chain followed by a text field's frame, drawn in `unfocused`, or `focused` when the
// field has the focus.
package fun Modifier.textFieldFrame(unfocused: Color, focused: Color): Modifier = append(
    ModifierElement.TextFieldFrame(unfocused, focused),
)

// Runs an app composing `content` in a window titled `title` of `width` × `height` logical
// pixels, until the window closes or a headless run's event script ends; then frees everything
// the app holds and returns. Compose Desktop's `singleWindowApplication`.
@DrivesComposition
public fun runApp(
    title: &String = "Prism",
    width: Int = 800,
    height: Int = 600,
    content: attached compose () -> Unit,
): Unit = prism_ui_run_app(
    title,
    width,
    height,
    content,
    { element, measurable, constraints -> measureElement(element, measurable, constraints) },
)

// Minimum and maximum widths and heights in logical pixels, which a parent gives a child it
// measures; `Constraints.Infinity` is an unbounded maximum. Compose's `Constraints`.
public struct Constraints : Copy {
    val minWidth: Int
    val maxWidth: Int
    val minHeight: Int
    val maxHeight: Int
}

// The constraints' companion: the unbounded maximum and the constraints' factories.
public struct ConstraintsCompanion : Copy { val Infinity: Int }

// `Constraints.Infinity`, `Int`'s largest value, and `Constraints.fixed(width, height)`.
public val Constraints: ConstraintsCompanion = ConstraintsCompanion(Infinity = 9223372036854775807)

// Exactly `width` × `height`.
public fun ConstraintsCompanion.fixed(width: Int, height: Int): Constraints = Constraints(
    width,
    width,
    height,
    height,
)

// Exactly `width` wide, and from 0 to unbounded high.
public fun ConstraintsCompanion.fixedWidth(width: Int): Constraints = Constraints(
    width,
    width,
    0,
    Infinity,
)

// Exactly `height` high, and from 0 to unbounded wide.
public fun ConstraintsCompanion.fixedHeight(height: Int): Constraints = Constraints(
    0,
    Infinity,
    height,
    height,
)

// Whether the maximum width is bounded.
public val Constraints.hasBoundedWidth: Bool get() = maxWidth != Constraints.Infinity

// Whether the maximum height is bounded.
public val Constraints.hasBoundedHeight: Bool get() = maxHeight != Constraints.Infinity

// Whether only one width is allowed.
public val Constraints.hasFixedWidth: Bool get() = maxWidth == minWidth

// Whether only one height is allowed.
public val Constraints.hasFixedHeight: Bool get() = maxHeight == minHeight

// Whether only a size of no area is allowed.
public val Constraints.isZero: Bool get() = maxWidth == 0 || maxHeight == 0

// `value` clamped between `minimum` and `maximum`.
private fun clamp(value: Int, minimum: Int, maximum: Int): Int = if (value < minimum) {
    minimum
} else if (value > maximum) {
    maximum
} else {
    value
}

// `width` clamped into the width bounds.
public fun Constraints.constrainWidth(width: Int): Int = clamp(width, minWidth, maxWidth)

// `height` clamped into the height bounds.
public fun Constraints.constrainHeight(height: Int): Int = clamp(height, minHeight, maxHeight)

// `other` clamped into these constraints, bound by bound.
public fun Constraints.constrain(other: Constraints): Constraints = Constraints(
    clamp(other.minWidth, minWidth, maxWidth),
    clamp(other.maxWidth, minWidth, maxWidth),
    clamp(other.minHeight, minHeight, maxHeight),
    clamp(other.maxHeight, minHeight, maxHeight),
)

// `maximum` plus `value`, at least 0, an unbounded maximum staying unbounded.
private fun offsetMaximum(maximum: Int, value: Int): Int = if (maximum == Constraints.Infinity) {
    maximum
} else {
    clamp(maximum + value, 0, Constraints.Infinity)
}

// The constraints with `horizontal` added to each width bound and `vertical` to each height
// bound, at least 0, unbounded maximums staying unbounded.
public fun Constraints.offset(horizontal: Int = 0, vertical: Int = 0): Constraints = Constraints(
    clamp(minWidth + horizontal, 0, Constraints.Infinity),
    offsetMaximum(maxWidth, horizontal),
    clamp(minHeight + vertical, 0, Constraints.Infinity),
    offsetMaximum(maxHeight, vertical),
)

// These constraints with the bounds given replaced.
public fun Constraints.copy(
    minWidth: Int = this.minWidth,
    maxWidth: Int = this.maxWidth,
    minHeight: Int = this.minHeight,
    maxHeight: Int = this.maxHeight,
): Constraints = Constraints(minWidth, maxWidth, minHeight, maxHeight)

// A child of a layout, which its parent's measure policy measures once, or the rest of a modifier
// chain, which a layout modifier's step measures once: a node and the position in its chain that
// measuring starts at, 0 for a child. Compose's `Measurable`.
public struct Measurable : Copy {
    package val node: Int
    package val element: Int
}

// A measured child or rest of a chain, of its measured size, which the policy or step that
// measured it places in its placement block. Compose's `Placeable`.
public struct Placeable : Copy {
    package val node: Int
    package val element: Int
    val width: Int
    val height: Int
}

// The receiver of a measure policy or a layout modifier's step, which gives it `layout`: a node
// and its chain position, the step's element or the chain's length for the content's policy.
// Compose's `MeasureScope`.
public struct MeasureScope : Copy {
    package val node: Int
    package val element: Int
}

// The receiver of a placement block, which gives it `place`. Compose's `PlacementScope`.
public struct PlacementScope : Copy {
    package val node: Int
    package val element: Int
}

// What a measure policy or a step returns: the size `layout` gave. Compose's `MeasureResult`.
public struct MeasureResult : Copy {
    val width: Int
    val height: Int
    package val node: Int
    package val element: Int
}

// Measures this child, or rest of a chain, under `constraints` and gives its placeable: once per
// measurement, from the measure policy of the child's parent or the step the rest follows only.
public fun Measurable.measure(constraints: Constraints): Placeable = prism_ui_measure(
    node,
    element,
    constraints,
)

// Gives the node's content, or the chain from the step, the size `width` × `height`, clamped into
// its constraints, and runs `placementBlock` at once to place what this measurement measured.
public fun MeasureScope.layout(
    width: Int,
    height: Int,
    placementBlock: PlacementScope.() -> Unit,
): MeasureResult {
    prism_ui_begin_placement(node, element, width, height)
    placementBlock(PlacementScope(node, element))
    prism_ui_end_placement(node, element)
    return MeasureResult(width, height, node, element)
}

// Places this child, or rest of a chain, with its top-left corner at `(x, y)` from the content's
// top-left corner, or from the step's.
context(scope: PlacementScope)
public fun Placeable.place(x: Int, y: Int): Unit = prism_ui_place(
    scope.node,
    scope.element,
    node,
    element,
    x,
    y,
)

// Places this child at `(x, y)`, mirrored in a right-to-left layout, which Prism does not have
// yet: as `place`.
context(scope: PlacementScope)
public fun Placeable.placeRelative(x: Int, y: Int): Unit = prism_ui_place(
    scope.node,
    scope.element,
    node,
    element,
    x,
    y,
)

// This size in pixels: a logical pixel is a pixel of layout.
context(scope: MeasureScope)
public fun Dp.roundToPx(): Int = value

// This chain followed by a layout modifier whose step is `measure`: it measures the rest of the
// chain, the elements after it then the node's content, once with `measurable.measure`, and
// calls `layout` with the size of the chain from it, placing the rest in its block. The node
// keeps `measure` as it keeps a click handler, so a chain with a step of the same code and equal
// captures is equal. Compose's `Modifier.layout`.
public fun Modifier.layout(
    measure: attached MeasureScope.(Measurable, Constraints) -> MeasureResult,
): Modifier = append(
    ModifierElement.LayoutModifier(HandlerId(prism_ui_register_layout_modifier(measure))),
)

// The step of a built-in layout element, Compose's `LayoutModifierNode.measure` of `PaddingNode`,
// `SizeNode`, `UnspecifiedConstraintsNode`, `FillNode` and `OffsetNode`: measures `measurable`,
// the rest of the chain after `element`, once, under the constraints the element gives, and
// places it. The runtime calls it for every such element of a chain being measured, with the
// element as it decoded it: sizes and paddings from 0 to `Int`'s largest 32-bit value, and -1
// for an axis a size leaves unset or a negative minimum. Other elements pass the constraints on.
// `runApp` gives it to the runtime; it lives here, beside `ModifierElement`, rather than in
// `/prism/compose/layout` with the modifiers that make the elements, since one function must
// see every variant.
package fun MeasureScope.measureElement(
    element: &ModifierElement,
    measurable: Measurable,
    constraints: Constraints,
): MeasureResult = when (element) {
    ModifierElement.Padding(val start, val top, val end, val bottom) -> {
        val horizontal = start + end
        val vertical = top + bottom
        val rest = prism_ui_measure(
            measurable.node,
            measurable.element,
            constraints.offset(-horizontal, -vertical),
        )
        placeRest(
            rest,
            constraints.constrainWidth(rest.width + horizontal),
            constraints.constrainHeight(rest.height + vertical),
            start,
            top,
        )
    }
    ModifierElement.Size(val width, val height) -> {
        val exactWidth = constraints.constrainWidth(width)
        val exactHeight = constraints.constrainHeight(height)
        val rest = prism_ui_measure(
            measurable.node,
            measurable.element,
            Constraints(
                if (width == -1) constraints.minWidth else exactWidth,
                if (width == -1) constraints.maxWidth else exactWidth,
                if (height == -1) constraints.minHeight else exactHeight,
                if (height == -1) constraints.maxHeight else exactHeight,
            ),
        )
        placeRest(rest, rest.width, rest.height, 0, 0)
    }
    ModifierElement.DefaultMinSize(val width, val height) -> {
        val rest = prism_ui_measure(
            measurable.node,
            measurable.element,
            Constraints(
                raisedMinimum(constraints.minWidth, width, constraints.maxWidth),
                constraints.maxWidth,
                raisedMinimum(constraints.minHeight, height, constraints.maxHeight),
                constraints.maxHeight,
            ),
        )
        placeRest(rest, rest.width, rest.height, 0, 0)
    }
    ModifierElement.FillMax(val width, val height, val fraction) -> {
        val fillWidth = width && constraints.maxWidth != Constraints.Infinity
        val fillHeight = height && constraints.maxHeight != Constraints.Infinity
        val exactWidth = constraints.constrainWidth(
            (constraints.maxWidth.toDouble() * fraction).toInt(),
        )
        val exactHeight = constraints.constrainHeight(
            (constraints.maxHeight.toDouble() * fraction).toInt(),
        )
        val rest = prism_ui_measure(
            measurable.node,
            measurable.element,
            Constraints(
                if (fillWidth) exactWidth else constraints.minWidth,
                if (fillWidth) exactWidth else constraints.maxWidth,
                if (fillHeight) exactHeight else constraints.minHeight,
                if (fillHeight) exactHeight else constraints.maxHeight,
            ),
        )
        placeRest(rest, rest.width, rest.height, 0, 0)
    }
    ModifierElement.Offset(val x, val y) -> {
        val rest = prism_ui_measure(measurable.node, measurable.element, constraints)
        placeRest(rest, rest.width, rest.height, x, y)
    }
    else -> {
        val rest = prism_ui_measure(measurable.node, measurable.element, constraints)
        placeRest(rest, rest.width, rest.height, 0, 0)
    }
}

// `minimum` raised to `value`, at most `maximum`, when it is 0 and `value` is specified (not
// negative): `defaultMinSize`'s rule.
private fun raisedMinimum(minimum: Int, value: Int, maximum: Int): Int {
    if (minimum != 0 || value < 0) {
        return minimum
    }
    return if (value < maximum) value else maximum
}

// A step's `layout(width, height) { rest.place(x, y) }`, through the runtime's entry points.
private fun MeasureScope.placeRest(
    rest: Placeable,
    width: Int,
    height: Int,
    x: Int,
    y: Int,
): MeasureResult {
    prism_ui_begin_placement(node, element, width, height)
    prism_ui_place(node, element, rest.node, rest.element, x, y)
    prism_ui_end_placement(node, element)
    return MeasureResult(width, height, node, element)
}

// A child's data for the toolkit's layouts: the first `weight` of its chain (0.0 for none)
// with its `fill`, and the code of its first `align` (-1 for none).
package struct ParentData : Copy {
    val weight: Double
    val alignment: Int
    val fill: Bool
}

// This child's data for the toolkit's layouts.
package val Measurable.parentData: ParentData get() = prism_ui_parent_data(node)

// A child measured in the running measurement of its parent, as the toolkit's layouts place it
// without keeping a list of placeables: its size, and the code of its first `align` (-1 for
// none).
package struct MeasuredChild : Copy {
    val width: Int
    val height: Int
    val alignment: Int
}

// A node group of `kind` whose content `measurePolicy` measures: `update` receives its node on
// every pass after its policy and modifier are set, then `content` composes its children.
@ExplicitGroupsComposable
package compose fun LayoutNode(
    kind: Int,
    measurePolicy: attached MeasureScope.(&List<Measurable>, Constraints) -> MeasureResult,
    modifier: Modifier,
    update: (NodeId) -> Unit,
    content: compose () -> Unit,
): Unit {
    val policy = prism_ui_register_measure_policy(measurePolicy)
    Node(
        kind,
        { node ->
            prism_ui_set_measure_policy(node.word, policy)
            prism_ui_set_modifier(node.word, modifier)
            update(node)
        },
    ) {
        content()
    }
}

// A node group of `kind` without children, measured by `measurePolicy`.
@ExplicitGroupsComposable
package compose fun LeafLayoutNode(
    kind: Int,
    measurePolicy: attached MeasureScope.(&List<Measurable>, Constraints) -> MeasureResult,
    modifier: Modifier,
    update: (NodeId) -> Unit,
): Unit {
    val policy = prism_ui_register_measure_policy(measurePolicy)
    LeafNode(kind) { node ->
        prism_ui_set_measure_policy(node.word, policy)
        prism_ui_set_modifier(node.word, modifier)
        update(node)
    }
}

// A layout of `content`'s children, which `measurePolicy` measures and places: Compose's
// `Layout`. The policy measures each child at most once with `measure`, then calls `layout`
// with the content's size, whose block places the children; a child it does not place is not
// shown.
public compose fun Layout(
    content: compose () -> Unit,
    modifier: Modifier = Modifier,
    measurePolicy: attached MeasureScope.(&List<Measurable>, Constraints) -> MeasureResult,
): Unit {
    LayoutNode(layoutKind, measurePolicy, modifier, { node -> }, content)
}

// Measures a child of the running measure policy's node (`element` 0), or the rest of the chain
// after the running step (`element` the step's plus one).
package external fun prism_ui_measure(node: Int, element: Int, constraints: Constraints): Placeable

// The size and alignment of a child measured by the running measure policy.
package external fun prism_ui_measured(node: Int): MeasuredChild

// Starts `layout`'s placement block in the measurement of `node` from `element`.
private external fun prism_ui_begin_placement(node: Int, element: Int, width: Int, height: Int)

// Ends `layout`'s placement block.
private external fun prism_ui_end_placement(node: Int, element: Int)

// Places a child of `parent` (`childElement` 0) at `(x, y)` from its content's top-left corner,
// or the rest of the chain after the step at `parentElement` from the step's.
package external fun prism_ui_place(
    parent: Int,
    parentElement: Int,
    child: Int,
    childElement: Int,
    x: Int,
    y: Int,
): Unit

// A child's data for the toolkit's layouts.
package external fun prism_ui_parent_data(node: Int): ParentData

// Runs an app of composable content, whose built-in layout modifiers `elementMeasurer` measures.
private external fun prism_ui_run_app(
    title: &String,
    width: Int,
    height: Int,
    content: attached compose () -> Unit,
    elementMeasurer: attached MeasureScope.(&ModifierElement, Measurable, Constraints) -> MeasureResult,
)

// Whether two handlers have the same code and equal captures.
private external fun prism_ui_handlers_equal(a: Int, b: Int): Bool

// Starts a node group.
private external fun prism_compose_start_node_group(composer: Int, key: Int, kind: Int): Int

// Ends a node group.
private external fun prism_compose_end_group(composer: Int)
