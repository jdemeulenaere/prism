// The toolkit's layouts, after Jetpack Compose's `compose-foundation-layout` artifact
// (`androidx.compose.foundation.layout`): boxes, columns, rows and spacers, their scopes and
// arrangements, and the layout modifiers. `weight` and `align` are extensions with the scope of
// a row, column or box as their context, so they resolve only in that scope's content. Each
// container is a `Layout` whose capture-free measure policy, written here, reads its
// arrangement and alignment back from its node and its children's parent data.
package prism.compose

import /prism/core
import ui

// The receiver of a box's content, which gives it `Modifier.align`.
public struct BoxScope : Copy {}

// The receiver of a column's content, which gives it `Modifier.weight` and `Modifier.align`.
public struct ColumnScope : Copy {}

// The receiver of a row's content, which gives it `Modifier.weight` and `Modifier.align`.
public struct RowScope : Copy {}

// Where a row's or column's children go along its main axis, by its code and spacing.
public struct Arrangement : Copy { val code: Int, val space: Int }

// Jetpack Compose's arrangements.
public struct Arrangements : Copy {
    val Top: Arrangement
    val Bottom: Arrangement
    val Start: Arrangement
    val End: Arrangement
    val Center: Arrangement
    val SpaceBetween: Arrangement
    val SpaceAround: Arrangement
    val SpaceEvenly: Arrangement
}

// The arrangements, as `Arrangement.Top`.
public val Arrangement: Arrangements = Arrangements(
    Top = Arrangement(0, 0),
    Bottom = Arrangement(1, 0),
    Start = Arrangement(2, 0),
    End = Arrangement(3, 0),
    Center = Arrangement(4, 0),
    SpaceBetween = Arrangement(5, 0),
    SpaceAround = Arrangement(6, 0),
    SpaceEvenly = Arrangement(7, 0),
)

// The arrangement placing children from the start with `space` between them.
public fun Arrangements.spacedBy(space: Dp): Arrangement = Arrangement(8, space.value)

// This chain followed by padding around the rest of the chain: Compose's three `padding`
// overloads in one, each side defaulting to its axis and each axis to `all`.
public fun Modifier.padding(
    all: Dp = 0.dp,
    horizontal: Dp = all,
    vertical: Dp = all,
    start: Dp = horizontal,
    top: Dp = vertical,
    end: Dp = horizontal,
    bottom: Dp = vertical,
): Modifier = append(ModifierElement.Padding(start.value, top.value, end.value, bottom.value))

// This chain followed by an exact width for the rest of the chain.
public fun Modifier.width(width: Dp): Modifier = append(ModifierElement.Size(width.value, -1))

// This chain followed by an exact height for the rest of the chain.
public fun Modifier.height(height: Dp): Modifier = append(ModifierElement.Size(-1, height.value))

// This chain followed by an exact size for the rest of the chain.
public fun Modifier.size(width: Dp, height: Dp = width): Modifier = append(
    ModifierElement.Size(width.value, height.value),
)

// This chain followed by minimum sizes for the rest of the chain, on each axis whose minimum is
// otherwise 0.
public fun Modifier.defaultMinSize(
    minWidth: Dp = Dp.Unspecified,
    minHeight: Dp = Dp.Unspecified,
): Modifier = append(ModifierElement.DefaultMinSize(minWidth.value, minHeight.value))

// This chain followed by `fraction` of the maximum width the constraints allow.
public fun Modifier.fillMaxWidth(fraction: Double = 1.0): Modifier = append(
    ModifierElement.FillMax(true, false, fraction),
)

// This chain followed by `fraction` of the maximum height the constraints allow.
public fun Modifier.fillMaxHeight(fraction: Double = 1.0): Modifier = append(
    ModifierElement.FillMax(false, true, fraction),
)

// This chain followed by `fraction` of the maximum size the constraints allow.
public fun Modifier.fillMaxSize(fraction: Double = 1.0): Modifier = append(
    ModifierElement.FillMax(true, true, fraction),
)

// This chain followed by the rest of the chain placed `x` to the right and `y` down, without
// changing the node's size or its place in its parent: the elements after it, the content and
// the children are drawn and hit there. Compose's `offset`.
public fun Modifier.offset(x: Dp = 0.dp, y: Dp = 0.dp): Modifier = append(
    ModifierElement.Offset(x.value, y.value),
)

// In a row, a share by `weight` of the width the children without one leave, exactly with
// `fill` and at most without it.
context(scope: RowScope)
public fun Modifier.weight(weight: Double, fill: Bool = true): Modifier = append(
    ModifierElement.Weight(weight, fill),
)

// In a column, a share by `weight` of the height the children without one leave, exactly with
// `fill` and at most without it.
context(scope: ColumnScope)
public fun Modifier.weight(weight: Double, fill: Bool = true): Modifier = append(
    ModifierElement.Weight(weight, fill),
)

// In a box, where this child goes, instead of the box's content alignment.
context(scope: BoxScope)
public fun Modifier.align(alignment: Alignment): Modifier = append(ModifierElement.Align(alignment))

// In a row, where this child goes vertically, instead of the row's alignment.
context(scope: RowScope)
public fun Modifier.align(alignment: Alignment): Modifier = append(ModifierElement.Align(alignment))

// In a column, where this child goes horizontally, instead of the column's alignment.
context(scope: ColumnScope)
public fun Modifier.align(alignment: Alignment): Modifier = append(ModifierElement.Align(alignment))

// Stacks its children over each other, each placed by its `align` or by `contentAlignment`, and
// as large as the largest.
public compose fun Box(
    modifier: Modifier = Modifier,
    contentAlignment: Alignment = Alignment.TopStart,
    content: compose BoxScope.() -> Unit,
): Unit {
    LayoutNode(
        boxKind,
        { measurables, constraints -> measureBox(measurables, constraints) },
        modifier,
        { node -> prism_ui_set_alignment(node.word, contentAlignment.code) },
    ) {
        content(BoxScope())
    }
}

// Places its children one below the other, by `verticalArrangement`, each aligned by its
// `align` or by the horizontal part of `horizontalAlignment`.
public compose fun Column(
    modifier: Modifier = Modifier,
    verticalArrangement: Arrangement = Arrangement.Top,
    horizontalAlignment: Alignment = Alignment.Start,
    content: compose ColumnScope.() -> Unit,
): Unit {
    LayoutNode(
        columnKind,
        { measurables, constraints -> measureLine(true, measurables, constraints) },
        modifier,
        { node ->
            prism_ui_set_arrangement(node.word, verticalArrangement.code, verticalArrangement.space)
            prism_ui_set_alignment(node.word, horizontalAlignment.code)
        },
    ) {
        content(ColumnScope())
    }
}

// Places its children one after the other, by `horizontalArrangement`, each aligned by its
// `align` or by the vertical part of `verticalAlignment`.
public compose fun Row(
    modifier: Modifier = Modifier,
    horizontalArrangement: Arrangement = Arrangement.Start,
    verticalAlignment: Alignment = Alignment.Top,
    content: compose RowScope.() -> Unit,
): Unit {
    LayoutNode(
        rowKind,
        { measurables, constraints -> measureLine(false, measurables, constraints) },
        modifier,
        { node ->
            prism_ui_set_arrangement(
                node.word,
                horizontalArrangement.code,
                horizontalArrangement.space,
            )
            prism_ui_set_alignment(node.word, verticalAlignment.code)
        },
    ) {
        content(RowScope())
    }
}

// An empty node whose size comes from its modifier and its constraints.
public compose fun Spacer(modifier: Modifier): Unit {
    LeafLayoutNode(
        spacerKind,
        { measurables, constraints -> layout(constraints.minWidth, constraints.minHeight) {} },
        modifier,
        { node -> },
    )
}

// The larger of `a` and `b`.
private fun larger(a: Int, b: Int): Int = if (a > b) a else b

// The constraints of a row's (`vertical` false) or column's child, main axis first.
private fun oriented(
    vertical: Bool,
    mainMinimum: Int,
    mainMaximum: Int,
    crossMaximum: Int,
): Constraints = if (vertical) {
    Constraints(0, crossMaximum, mainMinimum, mainMaximum)
} else {
    Constraints(mainMinimum, mainMaximum, 0, crossMaximum)
}

// A child's horizontal offset in `free` pixels of space by the alignment of `code`. A vertical
// alignment is at the start.
private fun horizontalOffset(code: Int, free: Int): Int {
    val part = if (code <= 8) {
        code % 3
    } else if (code <= 11) {
        code - 9
    } else {
        0
    }
    return if (part == 0) 0 else if (part == 1) free / 2 else free
}

// A child's vertical offset in `free` pixels of space by the alignment of `code`. A horizontal
// alignment is at the top.
private fun verticalOffset(code: Int, free: Int): Int {
    val part = if (code <= 8) {
        code / 3
    } else if (code >= 12) {
        code - 12
    } else {
        0
    }
    return if (part == 0) 0 else if (part == 1) free / 2 else free
}

// Where an arrangement places the first of `count` children in `free` pixels of space.
private fun arrangementStart(code: Int, free: Int, count: Int): Int = if (code == 1 || code == 3) {
    free
} else if (code == 4) {
    free / 2
} else if (code == 6) {
    if (count == 0) 0 else free / count / 2
} else if (code == 7) {
    free / (count + 1)
} else {
    0
}

// The extra gap an arrangement puts between `count` children in `free` pixels of space.
private fun arrangementGap(code: Int, free: Int, count: Int): Int = if (code == 5) {
    if (count <= 1) 0 else free / (count - 1)
} else if (code == 6) {
    if (count == 0) 0 else free / count
} else if (code == 7) {
    free / (count + 1)
} else {
    0
}

// A column (`vertical`) or a row: unweighted children in order under what remains of the main
// axis, then weighted children sharing what is left of a bounded main axis, then placement by
// the arrangement and each child's alignment. Compose's `RowColumnMeasurePolicy`. Its loops call
// the runtime's entry points directly and spell out the axis choices, since every call of a
// helper is a call through the function table in Tier 1 code.
private fun MeasureScope.measureLine(
    vertical: Bool,
    measurables: &List<Measurable>,
    constraints: Constraints,
): MeasureResult {
    val properties = prism_ui_line_properties(node)
    val arrangement = properties.code
    val alignment = properties.alignment
    val spacing = if (arrangement == 8) properties.space else 0
    val mainMaximum = if (vertical) constraints.maxHeight else constraints.maxWidth
    val crossMaximum = if (vertical) constraints.maxWidth else constraints.maxHeight
    val bounded = mainMaximum != Constraints.Infinity
    val count = measurables.size
    var measured = 0
    var used = 0
    var cross = 0
    var totalWeight = 0.0
    var weighted = 0
    for (measurable in measurables) {
        val weight = prism_ui_parent_data(measurable.node).weight
        if (bounded && weight > 0.0) {
            totalWeight += weight
            weighted += 1
        } else {
            var remaining = Constraints.Infinity
            if (bounded) {
                remaining = mainMaximum - used - spacing * measured
                if (remaining < 0) {
                    remaining = 0
                }
            }
            val placeable = prism_ui_measure(
                measurable.node,
                0,
                oriented(vertical, 0, remaining, crossMaximum),
            )
            val main = if (vertical) placeable.height else placeable.width
            val across = if (vertical) placeable.width else placeable.height
            used += main
            if (across > cross) {
                cross = across
            }
            measured += 1
        }
    }
    val gaps = spacing * larger(count - 1, 0)
    if (weighted > 0) {
        val remaining = larger(mainMaximum - used - gaps, 0)
        var given = 0
        var seen = 0
        for (measurable in measurables) {
            val data = prism_ui_parent_data(measurable.node)
            if (data.weight > 0.0) {
                seen += 1
                val share = if (seen == weighted) {
                    remaining - given
                } else {
                    (remaining.toDouble() * (data.weight / totalWeight)).toInt()
                }
                given += share
                val mainMinimum = if (data.fill) share else 0
                val placeable = prism_ui_measure(
                    measurable.node,
                    0,
                    oriented(vertical, mainMinimum, share, crossMaximum),
                )
                val main = if (vertical) placeable.height else placeable.width
                val across = if (vertical) placeable.width else placeable.height
                used += main
                if (across > cross) {
                    cross = across
                }
            }
        }
    }
    val content = used + gaps
    val width = constraints.constrainWidth(if (vertical) cross else content)
    val height = constraints.constrainHeight(if (vertical) content else cross)
    val mainSize = if (vertical) height else width
    val crossSize = if (vertical) width else height
    val free = larger(mainSize - content, 0)
    val start = arrangementStart(arrangement, free, count)
    val gap = arrangementGap(arrangement, free, count)
    return layout(width, height) {
        var position = start
        for (measurable in measurables) {
            val child = measurable.node
            val placeable = prism_ui_measured(child)
            val code = if (placeable.alignment >= 0) placeable.alignment else alignment
            if (vertical) {
                val along = horizontalOffset(code, crossSize - placeable.width)
                prism_ui_place(node, element, child, 0, along, position)
                position += placeable.height + spacing + gap
            } else {
                val along = verticalOffset(code, crossSize - placeable.height)
                prism_ui_place(node, element, child, 0, position, along)
                position += placeable.width + spacing + gap
            }
        }
    }
}

// A box: children under the constraints loosened, as large as the largest and at least the
// minimum, each child placed by its own alignment or the box's. Compose's `BoxMeasurePolicy`,
// which material's surfaces use too.
package fun MeasureScope.measureBox(
    measurables: &List<Measurable>,
    constraints: Constraints,
): MeasureResult {
    val loose = constraints.copy(minWidth = 0, minHeight = 0)
    var largestWidth = 0
    var largestHeight = 0
    for (measurable in measurables) {
        val placeable = prism_ui_measure(measurable.node, 0, loose)
        if (placeable.width > largestWidth) {
            largestWidth = placeable.width
        }
        if (placeable.height > largestHeight) {
            largestHeight = placeable.height
        }
    }
    val width = constraints.constrainWidth(largestWidth)
    val height = constraints.constrainHeight(largestHeight)
    if (measurables.size == 0) {
        return layout(width, height) {}
    }
    val alignment = prism_ui_alignment(node).code
    return layout(width, height) {
        for (measurable in measurables) {
            val child = measurable.node
            val placeable = prism_ui_measured(child)
            val code = if (placeable.alignment >= 0) placeable.alignment else alignment
            prism_ui_place(
                node,
                element,
                child,
                0,
                horizontalOffset(code, width - placeable.width),
                verticalOffset(code, height - placeable.height),
            )
        }
    }
}

// A row's or column's arrangement, by its code and spacing, and its alignment's code.
private struct LineProperties : Copy {
    val code: Int
    val space: Int
    val alignment: Int
}

// A row's or column's arrangement and alignment, as its node holds them.
private external fun prism_ui_line_properties(node: Int): LineProperties

// A box's, row's or column's alignment, as its node holds it.
private external fun prism_ui_alignment(node: Int): Alignment
