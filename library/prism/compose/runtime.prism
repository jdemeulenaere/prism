// The compose runtime for application code, after Jetpack Compose's `androidx.compose.runtime`:
// owned compositions, positional memoization with `remember`, keyed groups and restart scopes.
// A file uses it after `import /prism/compose/runtime`. Every declaration here is an intrinsic:
// the compiler lowers its calls to the compose runtime's protocol itself.
package prism.compose

// A composition: the groups, slots and nodes of one tree of composables. It is owned, neither
// `Copy` nor `Clone`, and dropping it disposes everything it holds.
public intrinsic struct Composition

// A handle of a restart scope of a composition, which `invalidate` marks for recomposition.
public intrinsic struct RecomposeScope : Copy

// Starts a composition of `content` and composes it once. The composition keeps the content,
// which captures the states it uses weakly, so those states stay borrowed while the
// composition is used.
public intrinsic fun composition(content: attached compose () -> Unit): Composition

// Replaces the content of this composition and recomposes its root.
public intrinsic fun Composition.setContent(content: attached compose () -> Unit): Unit

// Recomposes the invalid scopes of this composition, giving whether any was invalid.
public intrinsic fun Composition.recompose(): Bool

// The text dump of this composition: its groups and slots, then its nodes.
public intrinsic fun Composition.dump(): String

// The value `calculation` gave the first time this position of the composition was composed,
// computed again when one of the keys written before `calculation` changed: a copy of a `Copy`
// value, else a borrow of the value the composition keeps, which it drops when the position
// leaves the composition.
public intrinsic compose fun <T> remember(calculation: () -> T): T

// Composes `content` in a group identified by `value`, which keeps its state when keyed groups
// are reordered among their siblings.
public intrinsic compose fun key(value: Int, content: compose () -> Unit): Unit

// The innermost restart scope being composed, or the composition's root scope.
public intrinsic compose fun currentRecomposeScope(): RecomposeScope

// Marks this scope for recomposition by the next pass of its composition.
public intrinsic fun RecomposeScope.invalidate(): Unit

// A read-only state object: it owns one state, whose value lives in the compose runtime and
// never moves, so a state may be a field, an element or a local like any value. Dropping it
// retires the state. A composable that reads `value` is recomposed when it is written.
public intrinsic struct State<T>

// A state object that may be written; a borrow of one converts to a borrow of a `State<T>`.
public intrinsic struct MutableState<T>

// A reference to a state that does not keep it: `get` gives the state while it lives, and
// `null` once its owner dropped it.
public intrinsic struct WeakReference<T> : Copy

// Creates a state holding `value`. In a composable, create it in `remember`.
public intrinsic fun <T> mutableStateOf(value: T): MutableState<T>

// The value of the state: a copy of a `Copy` value, and otherwise the value in place, which
// may be borrowed but never moved out.
public intrinsic val <T> State<T>.value: T

// The value of the state, which an assignment outside composition replaces, recomposing its
// readers unless the new value is equal to the old one.
public intrinsic var <T> MutableState<T>.value: T

// Replaces the value with what `transform` makes of it, outside composition.
public intrinsic fun <T> MutableState<T>.update(transform: (T) -> T): Unit

// A weak reference to this state. Closures given to `attached` parameters capture states
// through it.
public intrinsic capture fun <T> State<T>.weak(): WeakReference<State<T>>

// A weak reference to this state. Closures given to `attached` parameters capture states
// through it.
public intrinsic capture fun <T> MutableState<T>.weak(): WeakReference<MutableState<T>>

// The state this reference names, or `null` once its owner dropped it.
public intrinsic fun <T> WeakReference<T>.get(): (&T)?

// Runs `effect` after the pass that composed this call, outside composition.
public intrinsic compose fun SideEffect(effect: attached () -> Unit): Unit
