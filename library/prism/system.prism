// The process: how a program ends itself. It is not a prelude module; import it with
// `import /prism/system`.
package prism

// Ends the process with exit status `status & 255`, after writing out the output printed so
// far. Nothing of the program runs after it: no drop, and no check of `--check-allocations`.
public fun exitProcess(status: Int): Nothing = prism_rt_exit(status)

// The runtime's entry point that flushes the output and exits.
private external fun prism_rt_exit(status: Int): Nothing
