package demo.ui

import /prism/compose/ui
import /prism/compose/layout
import /prism/compose/material3

// Universal trailing lambda support:
// - Call with parentheses + trailing lambda: Column(modifier = Modifier.padding(16.dp)) { ... }
// - Bare call with trailing lambda only: remember { ... }
public compose fun CounterView(initialCount: Int = 0): Unit {
    val count = remember { mutableStateOf(initialCount) }

    Column(modifier = Modifier.padding(16.dp)) {
        Text("Hello Prism UI")
    }
}
