// A tour of the UI toolkit: one screen that composes every composable of
// `/prism/compose/foundation`, `/prism/compose/layout` and `/prism/compose/material3`, and uses
// every modifier, the three shapes, named and constructed colours, every arrangement and every
// alignment at least once, around a remembered counter, a checkbox and a text field. Run it
// with `prism run examples/demo/ui/ui.prism`, or headless with
// `prism run --headless --events <script> examples/demo/ui/ui.prism`.
package demo.ui

import /prism/compose/ui
import /prism/compose/foundation
import /prism/compose/layout
import /prism/compose/material3

// A counter: a button counting its clicks and a reset button disabled at zero.
public compose fun CounterView(initialCount: Int = 0): Unit {
    val count = remember { mutableStateOf(initialCount) }
    Row(
        horizontalArrangement = Arrangement.spacedBy(8.dp),
        verticalAlignment = Alignment.CenterVertically,
    ) {
        Button(onClick = { count.value += 1 }) {
            Text("Clicked ${count.value} times")
        }
        Button(
            onClick = { count.value = 0 },
            enabled = count.value > 0,
            shape = RoundedCornerShape(4.dp),
            colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF336699)),
        ) {
            Text("Reset")
        }
    }
}

// A checkbox, a text field and a toggleable text, each showing its own remembered state.
compose fun Inputs() {
    val checked = remember { mutableStateOf(false) }
    val name = remember { mutableStateOf("") }
    val bold = remember { mutableStateOf(true) }
    Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
        Row(verticalAlignment = Alignment.CenterVertically) {
            Checkbox(checked = checked.value, onCheckedChange = { checked.value = it })
            Spacer(Modifier.width(8.dp))
            Text(if (checked.value) "Checked" else "Not checked")
        }
        Row(verticalAlignment = Alignment.CenterVertically) {
            TextField(
                value = name.value,
                onValueChange = { name.value = it },
                modifier = Modifier.weight(1.0),
            )
            Spacer(Modifier.width(8.dp))
            BasicText("Hello ${name.value}", style = TextStyle(Color.DarkGray, 14.sp))
        }
        BasicTextField(
            value = name.value,
            onValueChange = { name.value = it },
            modifier = Modifier.border(1.dp, Color.LightGray).padding(4.dp).fillMaxWidth(0.5),
        )
        Text(
            "Toggle me",
            modifier = Modifier.toggleable(value = bold.value, onValueChange = { bold.value = it }),
            color = if (bold.value) Color.Blue else Color.Gray,
            fontSize = 18.sp,
        )
    }
}

// Every arrangement of a row's children along its main axis, and the column ones.
compose fun Arrangements() {
    Column(verticalArrangement = Arrangement.spacedBy(2.dp)) {
        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.Start) {
            Swatch(Color.Red)
        }
        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.End) {
            Swatch(Color.Green)
        }
        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.Center) {
            Swatch(Color.Blue)
        }
        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
            Swatch(Color.Yellow)
            Swatch(Color.Cyan)
        }
        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceAround) {
            Swatch(Color.Magenta)
            Swatch(Color.Black)
        }
        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceEvenly) {
            Swatch(Color.White)
            Swatch(Color.Gray)
        }
        Row(Modifier.height(40.dp)) {
            Column(Modifier.fillMaxHeight(), verticalArrangement = Arrangement.Top) {
                Swatch(Color.Red)
            }
            Column(Modifier.fillMaxHeight(), verticalArrangement = Arrangement.Bottom) {
                Swatch(Color.Green)
            }
        }
    }
}

// A small square of `color`.
compose fun Swatch(color: Color) {
    Box(
        Modifier
            .size(12.dp)
            .background(color, CircleShape)
            .then(Modifier.border(1.dp, Color.DarkGray, CircleShape)),
    ) {}
}

// Every alignment: the nine of a box's content and of `align` in a box, then the horizontal
// ones in a column and the vertical ones in a row.
compose fun Alignments() {
    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
        Box(Modifier.size(60.dp).border(1.dp, Color.Gray), contentAlignment = Alignment.Center) {
            Swatch(Color.Red)
            Swatch(Color.Transparent)
        }
        Box(Modifier.size(60.dp).border(1.dp, Color.Gray)) {
            Box(Modifier.align(Alignment.TopStart)) { Swatch(Color.Red) }
            Box(Modifier.align(Alignment.TopCenter)) { Swatch(Color.Green) }
            Box(Modifier.align(Alignment.TopEnd)) { Swatch(Color.Blue) }
            Box(Modifier.align(Alignment.CenterStart)) { Swatch(Color.Yellow) }
            Box(Modifier.align(Alignment.CenterEnd)) { Swatch(Color.Cyan) }
            Box(Modifier.align(Alignment.BottomStart)) { Swatch(Color.Magenta) }
            Box(Modifier.align(Alignment.BottomCenter)) { Swatch(Color.Black) }
            Box(Modifier.align(Alignment.BottomEnd)) { Swatch(Color.Gray) }
        }
        Column(
            Modifier.width(60.dp).border(1.dp, Color.Gray),
            horizontalAlignment = Alignment.CenterHorizontally,
        ) {
            Swatch(Color.Red)
            Box(Modifier.align(Alignment.Start)) { Swatch(Color.Green) }
            Box(Modifier.align(Alignment.End)) { Swatch(Color.Blue) }
        }
        Row(Modifier.height(60.dp).border(1.dp, Color.Gray), verticalAlignment = Alignment.Bottom) {
            Swatch(Color.Red)
            Box(Modifier.align(Alignment.Top)) { Swatch(Color.Green) }
            Box(Modifier.align(Alignment.CenterVertically)) { Swatch(Color.Blue) }
        }
    }
}

// The tour: a surface holding a title, the counter, the inputs, the arrangements and the
// alignments, with a weighted column and a minimum size.
compose fun Tour() {
    Surface(modifier = Modifier.fillMaxSize(), color = Color.White, contentColor = Color.Black) {
        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
            Box(
                Modifier
                    .background(MaterialTheme.colorScheme.primary, RectangleShape)
                    .padding(horizontal = 12.dp, vertical = 4.dp)
                    .defaultMinSize(minWidth = 200.dp, minHeight = 28.dp)
                    .clickable(onClick = {}),
            ) {
                Text("Prism UI tour", color = MaterialTheme.colorScheme.onPrimary)
            }
            CounterView()
            Inputs()
            Arrangements()
            Alignments()
            Row(Modifier.fillMaxWidth().height(24.dp)) {
                Box(Modifier.weight(1.0).fillMaxHeight().background(Color(0xFFE8DEF8))) {}
                Column(Modifier.weight(2.0, fill = false)) {
                    Box(
                        Modifier
                            .weight(1.0)
                            .background(Color.LightGray)
                            .padding(start = 4.dp, top = 2.dp, end = 4.dp, bottom = 2.dp),
                    ) {
                        Text("weighted")
                    }
                }
            }
        }
    }
}

fun main() {
    runApp(title = "Prism UI tour", width = 640, height = 800) { Tour() }
}
