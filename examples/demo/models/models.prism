package demo.models

// Value struct (allocated inline on stack or inside parent struct)
public struct Point {
    val x: Double
    val y: Double
}

// Struct with owned fields (zero GC, zero ARC, deterministic cleanup)
public struct User {
    val id: UInt64
    var name: String
    val email: String?   // Nullable type
}

// Methods are extension functions. A `mut fun` borrows its receiver mutably, with nothing
// written at the call site, and names in its body resolve to fields of `this`
public mut fun User.rename(newName: &String): Unit {
    name = newName.clone()
}

// A plain `fun` borrows its receiver shared
public fun User.greet(): String = "Hello, " + name

// Shared borrows are implicit at call sites, and calling a `mut fun` on a `&mut` reborrows it
fun renameToAda(user: &mut User): Unit {
    user.rename("Ada")
}

// A free function taking `&mut` still needs an explicit `&mut` at the call site
public fun updateName(user: &mut User, newName: String): Unit {
    user.name = newName
}

fun renameLocal(original: User): String {
    var user = original
    updateName(&mut user, "Ada")
    user.rename("Lin")
    return user.greet()
}

// Writing a whole value through a mutable borrow uses prefix `*`
public fun resetCount(count: &mut Int): Unit {
    *count = 0
}

// Algebraic Data Types (Enums) & Recursive Types via Heap<T>
public enum Expr {
    Literal(Int)
    Add(Heap<Expr>, Heap<Expr>)
    Multiply(Heap<Expr>, Heap<Expr>)
}
