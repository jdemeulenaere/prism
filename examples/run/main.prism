// The reference program of `prism run`: run it with `prism run examples/run/main.prism`, and
// time it with `prism run --timings examples/run/main.prism`. It uses scalars, a struct, an enum
// with payloads, a nullable and strings.
package run

import /run/geometry/shapes
import /run/math/numbers

fun main() {
    var primes = 0
    for (n in 1..LIMIT) {
        if (!isPrime(n)) continue
        print(n)
        print(' ')
        primes += 1
    }
    println()
    println(primes)
    println(gcd(84, 36))
    println(sumTo(100))
    println(sumTo(100, 7))
    println(1.0 / 3.0)

    val p = Point(6, -3)
    val q = mirror(p)
    println(q.x)
    println(placeOf(p) == Place.Quadrant(4))
    println(placeOf(q) == placeOf(p))
    println(slope(p) ?: 0)
    println(slope(Point(1, 0)) ?: 0)

    val summary = primes.toString() + " primes up to " + LIMIT.toString()
    println(summary)
    println(summary.length)
}
