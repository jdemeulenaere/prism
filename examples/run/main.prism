// The reference program of `prism run`: run it with `prism run examples/run/main.prism`, and
// time it with `prism run --timings examples/run/main.prism`. It uses scalars, a struct, an enum
// with payloads matched by patterns, a destructuring declaration, a nullable, strings and string
// templates, an expression tree built from boxes, generic functions and extensions, closures
// and function values, and closures that own their captures: a handler kept in a struct and a
// closure returned from a function.
package run

import /run/generic/labels
import /run/geometry/shapes
import /run/math/expressions
import /run/math/numbers

fun triple(n: Int): Int = n * 3

struct Button {
    val label: String
    val onClick: () -> Int
}

fun button(label: String, onClick: escaping () -> Int): Button = Button(label, onClick)

fun press(b: &Button): Int = b.onClick()

fun describer(name: String): (Int) -> String = { n -> "$name = $n" }

fun main() {
    var primes = 0
    for (n in 1..LIMIT) {
        if (!isPrime(n)) continue
        print(n)
        print(' ')
        primes += 1
    }
    println()
    println(primes)
    println(gcd(84, 36))
    println(sumTo(100))
    println(sumTo(100, 7))
    println(1.0 / 3.0)

    val p = Point(6, -3)
    val q = mirror(p)
    println(q.x)
    println(placeOf(p) == Place.Quadrant(4))
    println(placeOf(q) == placeOf(p))
    println(slope(p) ?: 0)
    println(slope(Point(1, 0)) ?: 0)
    println(describe(placeOf(p)))
    val (x, y) = q
    println(x * 10 + y)

    val summary = "$primes primes up to $LIMIT"
    println(summary)
    println("$summary, ${summary.length} characters")

    val e = sumTimes(2, 3, 4)
    println(eval(e))
    val one = Expr.Multiply(Heap(Expr.Number(1)), Heap(sumTimes(1, 1, 5)))
    val copy = one.clone()
    println(eval(simplify(one)))
    println(simplify(copy) == sumTimes(1, 1, 5))

    val count = labeled("primes", primes)
    println("${count.label}: ${count.get()}")
    val name = labeled("name", "prism")
    println(name.value.length)
    println(firstOr(slope(Point(1, 0)), -1))

    var steps = 0
    repeat(4) { steps += primes }
    println(steps)
    println(twice(triple, 2))
    println(twice({ n -> n - steps }, 100))

    val greeting = "pressed"
    val bonus = steps
    val ok = button("ok") { greeting.length + bonus }
    println(press(ok) + press(ok))
    println(ok.label)
    val describeLimit = describer("limit")
    println(describeLimit(LIMIT))
}
