// The todo app's screen: a field and a button that add items, a row of filters, one row per
// shown item, keyed by its identifier, and the number of items left.
package apps.todo

import /prism/collections
import /prism/compose/layout
import /prism/compose/material3
import /prism/compose/runtime
import /prism/compose/ui
import model

// The app over an empty list.
package compose fun TodoApp(): Unit {
    val todos = remember { mutableStateOf<List<Todo>>(listOf()) }
    TodoScreen(todos)
}

// The whole screen of the items `todos`: the draft, the filter and the next identifier are
// remembered here, and each row's handlers capture the states they write.
package compose fun TodoScreen(todos: &MutableState<List<Todo>>): Unit {
    val draft = remember { mutableStateOf("") }
    val filter = remember { mutableStateOf(Filter.All) }
    val nextId = remember { mutableStateOf(todos.value.size + 1) }
    Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
        Row(verticalAlignment = Alignment.CenterVertically) {
            TextField(
                value = draft.value,
                onValueChange = { draft.value = it },
                modifier = Modifier.weight(1.0),
            )
            Spacer(Modifier.width(8.dp))
            Button(onClick = { addTodo(todos, draft, nextId) }) {
                Text("Add")
            }
        }
        FilterRow(filter)
        for (todo in todos.value) {
            // The key is outermost in the loop's body, so an item's row keeps its groups and
            // nodes when the items before it are removed or filtered out.
            key(todo.id) {
                if (filter.value.shows(todo)) {
                    TodoRow(todo, todos)
                }
            }
        }
        LeftCount(todos)
    }
}

// The number of items left: a restart scope of its own, which a toggle recomposes alone.
package compose fun LeftCount(todos: &State<List<Todo>>): Unit {
    Text("${activeCount(todos)} left")
}

// The three filters, the selected one disabled. Compose would pass `selected: Filter` and
// `onSelect: (Filter) -> Unit`, but a function value can be neither copied nor cloned, so three
// buttons cannot share one `onSelect`: the composable takes the filter's state instead (a
// follow-up of `reactive-app-verification` in `ROADMAP.md`).
package compose fun FilterRow(filter: &MutableState<Filter>): Unit {
    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
        Button(onClick = { filter.value = Filter.All }, enabled = filter.value != Filter.All) {
            Text("All")
        }
        Button(
            onClick = { filter.value = Filter.Active },
            enabled = filter.value != Filter.Active,
        ) {
            Text("Active")
        }
        Button(onClick = { filter.value = Filter.Done }, enabled = filter.value != Filter.Done) {
            Text("Done")
        }
    }
}

// One item of `todos`: a checkbox showing whether it is done, its title and a button removing
// it. A restart scope of its own, kept by its item's identity: a toggle recomposes this row
// alone, and typing into the field skips it.
package compose fun TodoRow(todo: &Todo, todos: &MutableState<List<Todo>>): Unit {
    Row(verticalAlignment = Alignment.CenterVertically) {
        Checkbox(checked = todo.done.value, onCheckedChange = { todo.done.value = it })
        Spacer(Modifier.width(8.dp))
        Text(todo.title, modifier = Modifier.weight(1.0))
        Button(onClick = { removeTodo(todos, todo.id) }) {
            Text("Remove")
        }
    }
}
