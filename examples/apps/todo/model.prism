// The todo app's model: its items, each holding its own done state, its filters, and the
// operations the screen's handlers call over the states they use, as Compose hoists state.
package apps.todo

// One item: its identifier, which keys its row, its title and whether it is done, a state of
// its own, so that checking it off writes only this item's state.
package struct Todo {
    val id: Int
    val title: String
    val done: MutableState<Bool>
}

// Which items the list shows.
package enum Filter : Copy {
    All
    Active
    Done
}

// Whether this filter shows `todo`.
package fun Filter.shows(todo: &Todo): Bool = when (this) {
    Filter.All -> true
    Filter.Active -> !todo.done.value
    Filter.Done -> todo.done.value
}

// Adds an item, not done, titled by `draft`, numbered by `nextId`, and clears the draft; an
// empty draft adds nothing.
package fun addTodo(
    todos: &MutableState<List<Todo>>,
    draft: &MutableState<String>,
    nextId: &MutableState<Int>,
): Unit {
    val title = draft.value.clone()
    if (title.length == 0) {
        return
    }
    val id = nextId.value
    nextId.value = id + 1
    todos.value.add(Todo(id, title, mutableStateOf(false)))
    draft.value = ""
}

// Removes the item `id`, keeping the others in order; its state goes with it.
package fun removeTodo(todos: &MutableState<List<Todo>>, id: Int): Unit {
    val index = todos.value.indexOfFirst { it.id == id }
    if (index >= 0) {
        todos.value.removeAt(index)
    }
}

// How many items are not done.
package fun activeCount(todos: &State<List<Todo>>): Int = todos.value.count { !it.done.value }

// `count` items titled `Item 1` to `Item <count>`, every third one done.
package fun sampleTodos(count: Int): List<Todo> {
    var todos: List<Todo> = listOf()
    for (n in 1..count) {
        todos.add(Todo(n, "Item $n", mutableStateOf(n % 3 == 0)))
    }
    return todos
}
